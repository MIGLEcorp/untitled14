+TYPED_TEST_P(PostAsyncResultsTest,
+             PostAsyncResults_DifferentCompletionInterfacePointer) {
+  base::test::SingleThreadTaskEnvironment task_environment;
+  auto original_fake =
+      Microsoft::WRL::Make<FakeIAsyncOperation<TypeParam>>();
+  auto callback_fake =
+      Microsoft::WRL::Make<FakeIAsyncOperation<TypeParam>>();
+  ComPtr<IAsyncOperation<TypeParam>> original_operation;
+  ComPtr<IAsyncOperation<TypeParam>> callback_operation;
+  ASSERT_HRESULT_SUCCEEDED(original_fake.As(&original_operation));
+  ASSERT_HRESULT_SUCCEEDED(callback_fake.As(&callback_operation));
+
+  base::test::AsyncResultsTestValues<TypeParam> templated_values;
+  callback_fake->CompleteWithResults(templated_values.GetTestValue_T());
+  original_fake->SetCompletionCallbackOperationForTesting(callback_operation.Get());
+
+  RunLoop run_loop;
+  auto quit_closure = run_loop.QuitClosure();
+  auto value_received = templated_values.GetDefaultValue_AsyncResultsT();
+  ASSERT_HRESULT_SUCCEEDED(PostAsyncResults(
+      original_operation,
+      base::BindLambdaForTesting(
+          [&](internal::AsyncResultsT<TypeParam> result) {
+            value_received = result;
+            std::move(quit_closure).Run();
+          })));
+
+  ASSERT_NO_FATAL_FAILURE(
+      original_fake->CompleteWithResults(templated_values.GetTestValue_T()));
+  run_loop.Run();
+  ASSERT_EQ(templated_values.GetTestValue_AsyncResultsT(), value_received);
+}
+
