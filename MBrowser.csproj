<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>MBrowser</AssemblyName>
    <Product>MBrowser</Product>
    <Title>MBrowser</Title>
    <Description>MBrowser — web browser</Description>
    <Company>MIGLEcorp</Company>
    <ApplicationIcon>assets\mbrowser.ico</ApplicationIcon>
    <RootNamespace>MBrowser</RootNamespace>
    <Version>4.4.0</Version>
    <InformationalVersion>4.4.0-rc.5</InformationalVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CefSharp.WinForms.NETCore" Version="154.0.340" />
    <Content Include="Native\MBrowser.GpuDiagnostics.dll" Link="MBrowser.GpuDiagnostics.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="assets\*.jpg;assets\sakura-*.png;assets\mbrowser.ico;assets\ATTRIBUTION.md;assets\REN-PY-ART-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Remove="Features\**\*.cs;Engine\WebKitPreview\**\*.cs;Engine\ImageOcr\**\*.cs;experimental\**\*.cs" />
    <ProjectReference Include="Features\MBrowser.Features.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishDir" />
    <Content Include="Features\bin\$(Configuration)\net10.0-windows\MBrowser.Features.dll" Link="Modules\MBrowser.Features.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
